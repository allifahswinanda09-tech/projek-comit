{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "jadwalsiaga-pwa-app",
  "name": "JadwalSiaga — Pengatur Jadwal & Alarm",
  "short_name": "JadwalSiaga",
  "description": "Aplikasi pengatur jadwal kuliah, sekolah, dan kerja dengan alarm sirine darurat dan gestur geser ke atas.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#211D35",
  "theme_color": "#211D35",
  "orientation": "portrait-primary",
  "lang": "id",
  "categories": [
    "productivity",
    "utilities",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "192x192 256x256 384x384 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Tambah Jadwal Baru",
      "short_name": "Tambah",
      "description": "Buka formulir tambah jadwal baru dengan cepat",
      "url": "./index.html?action=new",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Lihat Kalender",
      "short_name": "Kalender",
      "description": "Buka agenda bulanan",
      "url": "./index.html?tab=kalender",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Ganti Suara Alarm",
      "short_name": "Suara",
      "description": "Buka pengaturan pengganti suara alarm",
      "url": "./index.html?action=sound",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
